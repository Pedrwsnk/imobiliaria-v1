# =============================================================================
# .gitignore - API REST Imobiliária (Spring Boot + Maven + Flyway + MySQL)
# Java 25 | VS Code | Repositório público no GitHub
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SEGREDOS E CREDENCIAIS  (prioridade máxima em repositório público)
# -----------------------------------------------------------------------------
# Arquivos de variáveis de ambiente
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.env

# Configurações locais do Spring (senha do banco, tokens, etc.)
# Dica: coloque credenciais reais em application-local.properties e deixe
# em application.properties apenas valores seguros / variáveis ${...}
application-local.properties
application-local.yml
application-local.yaml
application-dev.properties
application-dev.yml
application-dev.yaml
application-secret*.properties
application-secret*.yml
application-secrets.*
application-prod.properties
application-prod.yml
application-prod.yaml
secrets/
secret/
*.secret
*.secrets

# Chaves, certificados e keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.crt
*.cer
*.der
*.csr
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.gpg
*.asc

# Credenciais de provedores de nuvem / ferramentas
.aws/
.azure/
.gcloud/
gcloud-service-key.json
service-account*.json
credentials.json
credentials.*.json
.npmrc
.pypirc
.netrc
settings-security.xml

# Arquivos de cliente HTTP com tokens/ambientes privados (VS Code REST Client / IntelliJ HTTP Client)
http-client.private.env.json
http-client.env.json
rest-client.env.json


